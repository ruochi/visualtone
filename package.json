{
  "name": "visualtone",
  "version": "0.4.1",
  "description": "Lite music and sound-effect synthesis from JSON scores",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "visualtone": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "example": "tsc && node examples/make-funk.mjs && node dist/cli.js render examples/funk.json out/funk.wav"
  },
  "keywords": ["audio", "synthesis", "music", "sfx", "json"],
  "license": "MIT",
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
